<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors backup_rules.xml for Android 12+'s device-transfer/cloud-backup rules. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="flex_exports" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
