<?xml version="1.0" encoding="utf-8"?>
<!-- Ride data is privacy-sensitive location history; it is excluded from Android's
     auto-backup so it never leaves the device via a cloud backup channel we don't control.
     See PRIVACY notes in README.md. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="flex_exports" />
</full-backup-content>
